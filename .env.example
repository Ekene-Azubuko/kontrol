APP_ENV=development
DEMO_AUTH=true
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Local simulation only. Supply a strong password for any non-local deployment.
POSTGRES_PASSWORD=local-simulation-only
CREAO_MODE=mock
CREAO_BASE_URL=https://agent.creao.ai
CREAO_API_KEY=
CREAO_API_VERSION=v1
CREAO_INPUT_FIELD=context
CREAO_TIMEOUT=180
# Completion checks, not agent execution speed. Increase if the provider rate-limits polling.
CREAO_POLL_SECONDS=2
# CREAO's currently documented and observed API Trigger routes.
CREAO_INVOKE_PATH=/api/v1/runs
CREAO_POLL_PATH=/api/v1/runs/{run_id}
CREAO_INTAKE_AGENT_ID=
CREAO_HOSPITAL_AGENT_ID=
CREAO_DISPATCH_AGENT_ID=
CREAO_PLANNING_AGENT_ID=
LIVE_SIMULATION_ENABLED=false
# Enable only the six hackathon fleet units; CREAO agents still run live.
DEMO_FLEET_ENABLED=false
WORKER_INTERVAL=1
MOCK_AGENT_SECONDS=3
DISPATCH_STAGE_SECONDS=12

# Fictional recorded-call exercises; live mode sends audio to the configured provider.
TRANSCRIPTION_MODE=mock
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_TIMEOUT=60
CALL_AUDIO_DIR=/app/call_audio
CALL_MAX_AUDIO_BYTES=20971520
CALL_MAX_DURATION_SECONDS=300
# Only extracted street addresses are sent; bundled exercise sites resolve locally.
# Set empty to disable external geocoding. Searches are restricted to the SF exercise area.
CALL_GEOCODING_URL=https://photon.komoot.io/api/
# Official SF street-node lookup for spoken intersections, including omitted street suffixes.
CALL_INTERSECTIONS_URL=https://data.sf.gov/resource/gmfx-8h6i.json
